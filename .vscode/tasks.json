{
  "version": "2.0.0",
  "tasks": [

    {
      "label": "API: Build .NET",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/ITS-MOBILE-API/ITS-MOBILE-API.csproj"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "API: Run .NET",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/ITS-MOBILE-API/ITS-MOBILE-API.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Mobile: Start Metro",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/ITS-MOBILE"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Mobile: Type Check",
      "type": "shell",
      "command": "npm run type-check",
      "options": {
        "cwd": "${workspaceFolder}/ITS-MOBILE"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Mobile: Android Run",
      "type": "shell",
      "command": "npm run android",
      "options": {
        "cwd": "${workspaceFolder}/ITS-MOBILE"
      },
      "problemMatcher": []
    }
  ]
}
