  "business_rules": [
    { "id": "BR-INTEL-001", "rule": "Đăng nhập yêu cầu đồng thời tài khoản hệ thống VÀ extension PBX (dual-credential)", "type": "Authorization", "features": ["M1-F001"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-002", "rule": "Phiên đăng nhập được lưu qua app restart (không cần đăng nhập lại)", "type": "State-transition", "features": ["M1-F001"], "severity": "Medium", "scope": "single-feature" },
    { "id": "BR-INTEL-003", "rule": "Xác thực phải dùng HTTPS + token session", "type": "Authorization", "features": ["M1-F001"], "severity": "High", "scope": "cross-cutting" },
    { "id": "BR-INTEL-004", "rule": "Đăng xuất phải xóa phiên local và yêu cầu đăng nhập mới", "type": "State-transition", "features": ["M1-F002"], "severity": "Medium", "scope": "single-feature" },
    { "id": "BR-INTEL-005", "rule": "Cuộc gọi nội bộ dùng SIP/VoIP qua tổng đài PBX", "type": "Validation", "features": ["M1-F003"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-006", "rule": "Danh bạ phải hiển thị trạng thái online/offline cho mỗi extension", "type": "Validation", "features": ["M1-F003"], "severity": "Medium", "scope": "single-feature" },
    { "id": "BR-INTEL-007", "rule": "Lịch sử cuộc gọi phải được ghi lại và xem được", "type": "State-transition", "features": ["M1-F003"], "severity": "Medium", "scope": "single-feature" },
    { "id": "BR-INTEL-008", "rule": "Cuộc gọi SOS phải hoạt động KHÔNG cần internet (GSM trực tiếp)", "type": "Validation", "features": ["M1-F004"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-009", "rule": "Nút SOS phải luôn hiển thị trên mọi màn hình trong ứng dụng", "type": "Validation", "features": ["M1-F004"], "severity": "High", "scope": "cross-cutting" },
    { "id": "BR-INTEL-010", "rule": "Thông tin cá nhân hiển thị read-only: tên, đơn vị, extension, chức vụ", "type": "Validation", "features": ["M1-F005"], "severity": "Low", "scope": "single-feature" },
    { "id": "BR-INTEL-011", "rule": "Danh sách công việc chỉ hiển thị nhiệm vụ được phân công cho người dùng hiện tại", "type": "Authorization", "features": ["M2-F001"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-012", "rule": "Tải danh sách công việc phải hoàn thành trong < 3 giây", "type": "Validation", "features": ["M2-F001"], "severity": "Medium", "scope": "single-feature" },
    { "id": "BR-INTEL-013", "rule": "Chi tiết công việc phải hiển thị phương án xử lý (phuong_an_xu_ly) từ TMC", "type": "Validation", "features": ["M2-F002"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-014", "rule": "Chi tiết công việc phải hiển thị tất cả trường hồ sơ sự cố từ ITS API (20+ trường)", "type": "Validation", "features": ["M2-F002"], "severity": "Medium", "scope": "single-feature" },
    { "id": "BR-INTEL-015", "rule": "Chuyển trạng thái nhiệm vụ phải theo thứ tự: 1 (Đã nhận) → 2 (Đang xử lý) → 3 (Hoàn thành)", "type": "State-transition", "features": ["M2-F003"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-016", "rule": "Không cho phép chuyển trạng thái ngược (không rollback)", "type": "State-transition", "features": ["M2-F003"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-017", "rule": "Ghi chú hiện trường (ghi_chu_hien_truong) có thể thêm khi cập nhật trạng thái", "type": "Validation", "features": ["M2-F003"], "severity": "Medium", "scope": "single-feature" },
    { "id": "BR-INTEL-018", "rule": "Cập nhật trạng thái phải đồng bộ về ITS backend theo thời gian thực", "type": "Notification", "features": ["M2-F003"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-019", "rule": "Ảnh hiện trường có thể đính kèm tùy chọn trong quá trình xử lý", "type": "Validation", "features": ["M2-F004"], "severity": "Medium", "scope": "single-feature" },
    { "id": "BR-INTEL-020", "rule": "Ảnh chụp từ camera thiết bị hoặc chọn từ thư viện ảnh", "type": "Validation", "features": ["M2-F004"], "severity": "Low", "scope": "single-feature" },
    { "id": "BR-INTEL-021", "rule": "Thông tin sự cố/sự kiện nhận từ ITS theo thời gian thực (push hoặc polling)", "type": "Notification", "features": ["M2-F005"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-022", "rule": "Mức độ sự cố có 3 cấp: Nhẹ / Trung bình / Nghiêm trọng", "type": "Validation", "features": ["M2-F005", "M2-F001", "M2-F002"], "severity": "Medium", "scope": "cross-cutting" },
    { "id": "BR-INTEL-023", "rule": "Push notification gửi cho 4 loại sự kiện: phân công, cập nhật trạng thái, hệ thống, TMC", "type": "Notification", "features": ["M3-F001"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-024", "rule": "Push notification hoạt động kể cả khi app ở background/killed", "type": "Notification", "features": ["M3-F001"], "severity": "High", "scope": "single-feature" },
    { "id": "BR-INTEL-025", "rule": "Thông báo hiển thị theo thứ tự thời gian ngược (mới nhất trước) với badge chưa đọc", "type": "Validation", "features": ["M3-F002"], "severity": "Low", "scope": "single-feature" },
    { "id": "BR-INTEL-026", "rule": "Người dùng có thể toggle trạng thái đã đọc / chưa đọc của thông báo", "type": "State-transition", "features": ["M3-F003"], "severity": "Low", "scope": "single-feature" },
    { "id": "BR-INTEL-027", "rule": "Ứng dụng phải hỗ trợ cả hai nền tảng iOS và Android", "type": "Validation", "features": ["M1-F001", "M1-F003", "M1-F004", "M2-F001", "M2-F003", "M3-F001"], "severity": "High", "scope": "cross-cutting" }
