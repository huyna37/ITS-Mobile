{
  "name": "its-mobile-vec-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace root cho dự án ITS Mobile VEC (MF-MobiSuite)",
  "scripts": {
    "dev": "npm --prefix ITS-MOBILE run web",
    "web": "npm --prefix ITS-MOBILE run web",
    "build": "npm --prefix ITS-MOBILE run build",
    "web:build": "npm --prefix ITS-MOBILE run build",
    "type-check": "npm --prefix ITS-MOBILE run type-check",
    "start": "npm --prefix ITS-MOBILE run start",
    "mobile:start": "npm --prefix ITS-MOBILE run start",
    "mobile:android": "npm --prefix ITS-MOBILE run android",
    "mobile:ios": "npm --prefix ITS-MOBILE run ios",
    "mobile:type-check": "npm --prefix ITS-MOBILE run type-check",
    "api:build": "dotnet build ITS-MOBILE-API/ITS-MOBILE-API.csproj",
    "api:run": "dotnet run --project ITS-MOBILE-API/ITS-MOBILE-API.csproj"
  }
}
